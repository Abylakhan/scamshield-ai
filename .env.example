# Copy to backend/.env and adjust. Every key below is OPTIONAL — the app works fully without them.

# --- AI provider. Without a key, the heuristic engine runs alone. ---
# auto = Gemini if GEMINI_API_KEY is set, otherwise Claude if ANTHROPIC_API_KEY is set. Also: gemini | anthropic | none
AI_PROVIDER=auto
# Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — lower is faster/cheaper
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30

# --- Threat intelligence (optional) ---
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Network checks on submitted URLs (SSRF-protected) ---
ENABLE_URL_FETCH=true
# RDAP domain-age lookup via rdap.org (no key required)
ENABLE_DOMAIN_AGE=true
FETCH_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=262144
FETCH_MAX_REDIRECTS=5

# --- App ---
DATABASE_URL=sqlite:///./scamshield.db
# Optional: path to a custom scoring ruleset (defaults to backend/app/engine/ruleset.json)
# SCORING_RULESET_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Analysis requests per client IP per minute (the 5-minute demo uses ~10)
RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_CHARS=5000
